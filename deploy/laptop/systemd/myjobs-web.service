[Unit]
Description=myjobs web feed (:3000, public via Tailscale Funnel)
After=myjobs-api.service

[Service]
Slice=myjobs.slice
WorkingDirectory=%h/myjobs/web
Environment=NODE_ENV=production
# ADMIN_TOKEN for /admin
EnvironmentFile=%h/myjobs/.env
ExecStart=/usr/bin/npm start -- --port 3000 --hostname 0.0.0.0
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
