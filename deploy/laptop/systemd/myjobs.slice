[Unit]
Description=myjobs resource budget (D30)

[Slice]
# api + web + 3 workers share 4 of the laptop's 8 threads and 6.5 GB; Postgres and Redis get 1 thread and ~1.3 GB in
# docker-compose.yml, so myjobs stays under 8 GB (D30). The rest keeps the CPU out of thermal throttling.
CPUQuota=400%
MemoryHigh=6G
MemoryMax=6500M
