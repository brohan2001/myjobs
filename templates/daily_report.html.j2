<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Job Report — {{ run_date }}</title>
<style>
  :root {
    --bg: #0f1117; --surface: #1a1d27; --border: #2a2d3e;
    --text: #e2e8f0; --muted: #64748b; --accent: #6366f1;
    --green: #22c55e; --yellow: #eab308; --red: #ef4444;
    --blue: #3b82f6; --purple: #a855f7; --orange: #f97316;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--text); font-family: 'Inter', system-ui, sans-serif; font-size: 14px; line-height: 1.6; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }

  /* Header */
  .header { background: var(--surface); border-bottom: 1px solid var(--border); padding: 24px 32px; }
  .header h1 { font-size: 22px; font-weight: 700; color: var(--text); margin-bottom: 4px; }
  .header .subtitle { color: var(--muted); font-size: 13px; }
  .stats-row { display: flex; gap: 24px; margin-top: 16px; flex-wrap: wrap; }
  .stat { display: flex; flex-direction: column; }
  .stat-val { font-size: 20px; font-weight: 700; color: var(--accent); }
  .stat-lbl { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; }

  /* Layout */
  .container { max-width: 1100px; margin: 0 auto; padding: 24px 16px; }

  /* Job card */
  .job-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 20px; margin-bottom: 14px; }
  .job-card:hover { border-color: var(--accent); }
  .card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
  .card-rank { font-size: 12px; color: var(--muted); font-weight: 600; min-width: 28px; }
  .card-title-group { flex: 1; }
  .card-title { font-size: 16px; font-weight: 700; color: var(--text); margin-bottom: 2px; }
  .card-company { font-size: 13px; color: var(--muted); }
  .card-score-block { text-align: right; }
  .score-circle { background: var(--accent); color: #fff; border-radius: 50%; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 15px; margin-left: auto; }
  .score-circle.high { background: var(--green); }
  .score-circle.mid  { background: var(--yellow); color: #000; }
  .score-circle.low  { background: var(--red); }

  /* Badges */
  .badges { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }
  .badge { font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 99px; text-transform: uppercase; letter-spacing: 0.04em; }
  .visa-yes     { background: #16a34a22; color: var(--green); border: 1px solid #16a34a55; }
  .visa-unknown { background: #ca8a0422; color: var(--yellow); border: 1px solid #ca8a0455; }
  .visa-no      { background: #dc262622; color: var(--red); border: 1px solid #dc262655; }
  .role-backend  { background: #6366f122; color: #818cf8; border: 1px solid #6366f155; }
  .role-cloud    { background: #3b82f622; color: #60a5fa; border: 1px solid #3b82f655; }
  .role-fullstack{ background: #8b5cf622; color: #a78bfa; border: 1px solid #8b5cf655; }
  .role-frontend { background: #ec489922; color: #f472b6; border: 1px solid #ec489955; }
  .role-mobile   { background: #f9731622; color: #fb923c; border: 1px solid #f9731655; }
  .role-network  { background: #0891b222; color: #22d3ee; border: 1px solid #0891b255; }
  .role-ds       { background: #84cc1622; color: #a3e635; border: 1px solid #84cc1655; }
  .role-ml       { background: #f59e0b22; color: #fbbf24; border: 1px solid #f59e0b55; }
  .role-other    { background: #6b728022; color: #9ca3af; border: 1px solid #6b728055; }
  .badge-remote  { background: #06b6d422; color: #22d3ee; border: 1px solid #06b6d455; }
  .badge-senior  { background: #ef444422; color: #f87171; border: 1px solid #ef444455; }

  /* Meta row */
  .meta { font-size: 12px; color: var(--muted); margin-bottom: 10px; }
  .meta span { margin-right: 14px; }

  /* Skills */
  .skills-row { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }
  .skill-chip { font-size: 11px; padding: 2px 8px; border-radius: 4px; }
  .skill-yes { background: #16a34a22; color: #86efac; border: 1px solid #16a34a44; }
  .skill-no  { background: #37415122; color: #6b7280; border: 1px solid #37415144; }

  /* Score breakdown */
  .score-breakdown { display: flex; gap: 10px; flex-wrap: wrap; }
  .score-item { display: flex; flex-direction: column; align-items: center; background: #0f111722; border: 1px solid var(--border); border-radius: 6px; padding: 6px 12px; min-width: 72px; }
  .score-item .pts { font-size: 15px; font-weight: 700; color: var(--accent); }
  .score-item .max { font-size: 10px; color: var(--muted); }
  .score-item .lbl { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; margin-top: 2px; }

  /* Apply button */
  .card-footer { display: flex; justify-content: flex-end; margin-top: 12px; }
  .apply-btn { background: var(--accent); color: #fff; padding: 7px 18px; border-radius: 6px; font-size: 13px; font-weight: 600; }
  .apply-btn:hover { background: #4f46e5; text-decoration: none; }

  /* Footer */
  .footer { text-align: center; padding: 32px; color: var(--muted); font-size: 12px; }

  @media (max-width: 600px) {
    .card-top { flex-direction: column; }
    .score-circle { margin-left: 0; }
  }
</style>
</head>
<body>

<div class="header">
  <h1>Daily Job Report &mdash; {{ run_date }}</h1>
  <div class="subtitle">Top {{ jobs|length }} jobs ranked by relevance</div>
  <div class="stats-row">
    <div class="stat"><span class="stat-val">{{ stats.jobs_scraped }}</span><span class="stat-lbl">Scraped</span></div>
    <div class="stat"><span class="stat-val">{{ stats.jobs_new }}</span><span class="stat-lbl">New</span></div>
    <div class="stat"><span class="stat-val">{{ stats.shortlisted }}</span><span class="stat-lbl">Shortlisted</span></div>
    <div class="stat"><span class="stat-val">{{ "%.0f"|format(stats.elapsed_s // 60) }}m {{ "%.0f"|format(stats.elapsed_s % 60) }}s</span><span class="stat-lbl">Run Time</span></div>
    {% if stats.errors > 0 %}
    <div class="stat"><span class="stat-val" style="color:var(--yellow)">{{ stats.errors }}</span><span class="stat-lbl">Errors</span></div>
    {% endif %}
  </div>
</div>

<div class="container">
{% for job in jobs %}
  {% set score_int = job.score_pct|int %}
  {% set score_class = "high" if score_int >= 70 else ("mid" if score_int >= 45 else "low") %}
  <div class="job-card">
    <div class="card-top">
      <span class="card-rank">#{{ loop.index }}</span>
      <div class="card-title-group">
        <div class="card-title">{{ job.title }}</div>
        <div class="card-company">{{ job.company_name }}{% if job.domain %} &middot; {{ job.domain }}{% endif %}</div>
      </div>
      <div class="card-score-block">
        <div class="score-circle {{ score_class }}">{{ score_int }}</div>
      </div>
    </div>

    <div class="badges">
      <span class="badge {{ visa_class(job.visa_signal) }}">{{ visa_label(job.visa_signal) }}</span>
      {% if job.role_category %}
      <span class="badge {{ role_badge_class(job.role_category) }}">{{ job.role_category|upper }}</span>
      {% endif %}
      {% if job.remote %}<span class="badge badge-remote">REMOTE</span>{% endif %}
      {% if job.tier == 1 %}<span class="badge" style="background:#f9731622;color:#fb923c;border:1px solid #f9731655">TIER 1</span>{% endif %}
    </div>

    <div class="meta">
      {% if job.location %}<span>📍 {{ job.location }}</span>{% endif %}
      {% if job.posted_date %}<span>📅 {{ job.posted_date }}</span>{% endif %}
      <span>🔗 {{ job.ats_type|upper }}</span>
      {% if job.industry %}<span>🏢 {{ job.industry }}</span>{% endif %}
    </div>

    {% if job.matched_skills %}
    <div class="skills-row">
      {% for skill in job.matched_skills %}
        <span class="skill-chip skill-yes">✓ {{ skill }}</span>
      {% endfor %}
      {% for skill in job.missing_skills %}
        <span class="skill-chip skill-no">✗ {{ skill }}</span>
      {% endfor %}
    </div>
    {% endif %}

    <div class="score-breakdown">
      <div class="score-item">
        <span class="pts">{{ job.skill_pts }}</span>
        <span class="max">/{{ weights.skill }}</span>
        <span class="lbl">Skill</span>
      </div>
      <div class="score-item">
        <span class="pts">{{ job.role_pts }}</span>
        <span class="max">/{{ weights.role }}</span>
        <span class="lbl">Role</span>
      </div>
      <div class="score-item">
        <span class="pts">{{ job.visa_pts }}</span>
        <span class="max">/{{ weights.visa }}</span>
        <span class="lbl">Visa</span>
      </div>
      <div class="score-item">
        <span class="pts">{{ job.recency_pts }}</span>
        <span class="max">/{{ weights.recency }}</span>
        <span class="lbl">Recency</span>
      </div>
      <div class="score-item">
        <span class="pts">{{ job.company_pts }}</span>
        <span class="max">/{{ weights.company }}</span>
        <span class="lbl">Company</span>
      </div>
    </div>

    <div class="card-footer">
      <a class="apply-btn" href="{{ job.url }}" target="_blank" rel="noopener">Apply ↗</a>
    </div>
  </div>
{% else %}
  <p style="color:var(--muted);text-align:center;padding:48px">No jobs shortlisted for {{ run_date }}.</p>
{% endfor %}
</div>

<div class="footer">
  Generated by myjobs &middot; {{ run_date }}
</div>

</body>
</html>
