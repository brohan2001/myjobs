<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>myjobs live</title>
<style>
  :root {
    --bg: #0f1117; --surface: #1a1d27; --border: #2a2d3e;
    --text: #e2e8f0; --muted: #64748b; --accent: #6366f1;
    --green: #22c55e; --yellow: #eab308; --red: #ef4444;
    --blue: #3b82f6; --purple: #a855f7; --orange: #f97316;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--text); font-family: 'Inter', system-ui, sans-serif; font-size: 14px; line-height: 1.6; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }

  /* Header */
  .header { background: var(--surface); border-bottom: 1px solid var(--border); padding: 18px 28px; display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .header-brand { font-size: 20px; font-weight: 800; color: var(--text); white-space: nowrap; }
  .header-brand .live-dot { display: inline-block; width: 9px; height: 9px; background: var(--green); border-radius: 50%; margin-left: 6px; animation: pulse 2s infinite; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.4} }
  .header-meta { color: var(--muted); font-size: 12px; white-space: nowrap; }
  .header-spacer { flex: 1; }
  .sort-group { display: flex; gap: 4px; align-items: center; flex-wrap: wrap; }
  .sort-btn { background: transparent; border: 1px solid var(--border); color: var(--muted); padding: 4px 10px; border-radius: 6px; font-size: 12px; cursor: pointer; transition: all .15s; }
  .sort-btn:hover { border-color: var(--muted); color: var(--text); }
  .sort-btn.active { border-color: var(--accent); color: var(--accent); background: #6366f111; }
  .filter-sep { width: 1px; height: 20px; background: var(--border); margin: 0 4px; }
  .refresh-btn { background: var(--accent); color: #fff; border: none; padding: 8px 18px; border-radius: 7px; font-size: 13px; font-weight: 600; cursor: pointer; white-space: nowrap; display: flex; align-items: center; gap: 7px; }
  .refresh-btn:disabled { opacity: .55; cursor: default; }
  .spinner { width: 13px; height: 13px; border: 2px solid #ffffff55; border-top-color: #fff; border-radius: 50%; animation: spin .7s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* Stats bar */
  .stats-bar { background: #0f111799; border-bottom: 1px solid var(--border); padding: 10px 28px; display: flex; gap: 28px; flex-wrap: wrap; }
  .stat { display: flex; flex-direction: column; }
  .stat-val { font-size: 18px; font-weight: 700; color: var(--accent); }
  .stat-lbl { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; }

  /* Countdown */
  .countdown { font-size: 11px; color: var(--muted); padding: 8px 28px; background: var(--bg); border-bottom: 1px solid var(--border); }

  /* Layout: sidebar + main */
  .layout { display: flex; gap: 0; min-height: calc(100vh - 140px); }

  /* Sidebar */
  .sidebar { width: 220px; flex-shrink: 0; border-right: 1px solid var(--border); padding: 12px 8px; overflow-y: auto; max-height: calc(100vh - 140px); position: sticky; top: 0; }
  .sidebar-all { font-size: 13px; font-weight: 600; padding: 6px 10px; border-radius: 6px; cursor: pointer; color: var(--text); margin-bottom: 8px; }
  .sidebar-all:hover, .sidebar-all.active { background: #6366f122; color: var(--accent); }
  .sidebar-section { margin-bottom: 4px; }
  .sidebar-header { font-size: 10px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; padding: 8px 10px 4px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; }
  .sidebar-header:hover { color: var(--text); }
  .sidebar-body { overflow: hidden; }
  .sidebar-company { font-size: 12px; padding: 4px 10px; border-radius: 5px; cursor: pointer; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: flex; justify-content: space-between; align-items: center; }
  .sidebar-company:hover { background: var(--surface); color: var(--text); }
  .sidebar-company.active { background: #6366f122; color: var(--accent); }
  .job-count-badge { font-size: 10px; opacity: .6; flex-shrink: 0; margin-left: 4px; }

  /* Main content */
  .main-content { flex: 1; min-width: 0; padding: 20px 20px; }

  /* NEW badge */
  .new-badge { position: absolute; top: -8px; left: 14px; background: var(--green); color: #fff; font-size: 10px; font-weight: 800; padding: 1px 8px; border-radius: 99px; letter-spacing: .05em; box-shadow: 0 0 10px #22c55e55; animation: fadeNew 1s ease; }
  @keyframes fadeNew { from{opacity:0;transform:translateY(-4px)} to{opacity:1;transform:translateY(0)} }

  /* Job card */
  .job-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 20px; margin-bottom: 14px; position: relative; transition: border-color .15s; }
  .job-card:hover { border-color: var(--accent); }
  .job-card.is-new { border-color: #22c55e55; }
  .card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
  .card-rank { font-size: 12px; color: var(--muted); font-weight: 600; min-width: 28px; }
  .card-title-group { flex: 1; }
  .card-title { font-size: 16px; font-weight: 700; color: var(--text); margin-bottom: 2px; }
  .card-company { font-size: 13px; color: var(--muted); }
  .score-circle { background: var(--accent); color: #fff; border-radius: 50%; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 15px; flex-shrink: 0; }
  .score-circle.high { background: var(--green); }
  .score-circle.mid  { background: var(--yellow); color: #000; }
  .score-circle.low  { background: var(--red); }

  /* Badges */
  .badges { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 10px; }
  .badge { font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 99px; text-transform: uppercase; letter-spacing: .04em; }
  .visa-yes     { background: #16a34a22; color: var(--green); border: 1px solid #16a34a55; }
  .visa-unknown { background: #ca8a0422; color: var(--yellow); border: 1px solid #ca8a0455; }
  .visa-no      { background: #dc262622; color: var(--red); border: 1px solid #dc262655; }
  .role-backend  { background: #6366f122; color: #818cf8; border: 1px solid #6366f155; }
  .role-cloud    { background: #3b82f622; color: #60a5fa; border: 1px solid #3b82f655; }
  .role-fullstack{ background: #8b5cf622; color: #a78bfa; border: 1px solid #8b5cf655; }
  .role-frontend { background: #ec489922; color: #f472b6; border: 1px solid #ec489955; }
  .role-mobile   { background: #f9731622; color: #fb923c; border: 1px solid #f9731655; }
  .role-network  { background: #0891b222; color: #22d3ee; border: 1px solid #0891b255; }
  .role-ds       { background: #84cc1622; color: #a3e635; border: 1px solid #84cc1655; }
  .role-ml       { background: #f59e0b22; color: #fbbf24; border: 1px solid #f59e0b55; }
  .role-other    { background: #6b728022; color: #9ca3af; border: 1px solid #6b728055; }
  .badge-remote  { background: #06b6d422; color: #22d3ee; border: 1px solid #06b6d455; }
  .badge-src     { background: #37415122; color: #9ca3af; border: 1px solid #37415155; }
  .badge-tier1   { background: #f9731622; color: #fb923c; border: 1px solid #f9731655; }
  .badge-exp-high { background: #dc262622; color: #f87171; border: 1px solid #dc262655; }
  .badge-exp-ok   { background: #16a34a22; color: #86efac; border: 1px solid #16a34a55; }

  /* Meta */
  .meta { font-size: 12px; color: var(--muted); margin-bottom: 10px; display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }
  .posted-time { font-size: 13px; font-weight: 600; }
  .posted-fresh  { color: var(--green); }
  .posted-recent { color: var(--yellow); }
  .posted-old    { color: var(--muted); }

  /* Skills */
  .skills-row { display: flex; gap: 5px; flex-wrap: wrap; margin-bottom: 10px; }
  .skill-chip { font-size: 11px; padding: 2px 8px; border-radius: 4px; }
  .skill-yes { background: #16a34a22; color: #86efac; border: 1px solid #16a34a44; }
  .skill-no  { background: #37415122; color: #6b7280; border: 1px solid #37415144; }

  /* Score breakdown */
  .score-breakdown { display: flex; gap: 8px; flex-wrap: wrap; }
  .score-item { display: flex; flex-direction: column; align-items: center; background: #0f111722; border: 1px solid var(--border); border-radius: 6px; padding: 5px 10px; min-width: 64px; }
  .score-item .pts { font-size: 15px; font-weight: 700; color: var(--accent); }
  .score-item .max { font-size: 10px; color: var(--muted); }
  .score-item .lbl { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; margin-top: 2px; }

  /* Apply button */
  .card-footer { display: flex; justify-content: flex-end; margin-top: 12px; }
  .apply-btn { background: var(--accent); color: #fff; padding: 7px 18px; border-radius: 6px; font-size: 13px; font-weight: 600; }
  .apply-btn:hover { background: #4f46e5; text-decoration: none; }

  /* Empty state */
  .empty { text-align: center; padding: 64px; color: var(--muted); }
  .empty h2 { font-size: 18px; margin-bottom: 8px; }

  /* Toast */
  .toast { position: fixed; bottom: 24px; right: 24px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 12px 18px; font-size: 13px; box-shadow: 0 4px 20px #00000055; transition: opacity .3s; z-index: 100; }
  .toast.hidden { opacity: 0; pointer-events: none; }

  @media (max-width: 700px) {
    .sidebar { display: none; }
    .card-top { flex-direction: column; }
    .header { flex-direction: column; align-items: flex-start; }
  }
</style>
</head>
<body>

<div class="header">
  <div class="header-brand">myjobs<span class="live-dot"></span></div>
  <div class="header-meta" id="lastRefreshed">Loading…</div>
  <div class="header-spacer"></div>
  <div class="sort-group" id="sortGroup">
    <button class="sort-btn active" onclick="setSort('score')">Score</button>
    <button class="sort-btn" onclick="setSort('posted')">Newest</button>
    <button class="sort-btn" onclick="setSort('company')">Company</button>
    <div class="filter-sep"></div>
    <button class="sort-btn" id="usOnlyBtn" onclick="toggleFilter('usOnly')">🇺🇸 US Only</button>
    <button class="sort-btn" id="newGradBtn" onclick="toggleFilter('newGrad')">🎓 New Grad</button>
  </div>
  <button class="refresh-btn" id="refreshBtn" onclick="triggerRefresh()">
    <span id="refreshIcon"></span>Refresh Now
  </button>
</div>

<div class="stats-bar" id="statsBar">
  <div class="stat"><span class="stat-val" id="statTotal">—</span><span class="stat-lbl">Shortlisted</span></div>
  <div class="stat"><span class="stat-val" id="statNew" style="color:var(--green)">—</span><span class="stat-lbl">New This View</span></div>
  <div class="stat"><span class="stat-val" id="statFresh" style="color:var(--yellow)">—</span><span class="stat-lbl">Posted &lt;24h</span></div>
</div>

<div class="countdown" id="countdown"></div>

<div class="layout">
  <div class="sidebar" id="sidebar">
    <div class="sidebar-all active" id="sidebarAll" onclick="selectCompany(null)">All Companies</div>
  </div>
  <div class="main-content" id="jobsContainer">
    <div class="empty"><h2>Loading jobs…</h2><p>Fetching from database…</p></div>
  </div>
</div>

<div class="toast hidden" id="toast"></div>

<script>
const WEIGHTS = { skill: 35, role: 25, visa: 20, recency: 10, company: 10 };
const AUTO_REFRESH_MS = 10 * 60 * 1000;
let allJobs = [];
let sortKey = 'score';
let nextRefreshAt = Date.now() + AUTO_REFRESH_MS;
let countdownTimer = null;
let pollTimer = null;
let usOnly = false;
let newGrad = false;
let activeCompanyId = null;

// ── Relative time ──────────────────────────────────────────────────────────────

function relTime(iso) {
  if (!iso) return null;
  const diff = Date.now() - new Date(iso);
  const h = diff / 3.6e6;
  if (h < 0.02) return { text: 'just now', cls: 'posted-fresh' };
  if (h < 1)   return { text: Math.round(h * 60) + 'm ago', cls: 'posted-fresh' };
  if (h < 6)   return { text: Math.round(h) + 'h ago', cls: 'posted-fresh' };
  if (h < 24)  return { text: Math.round(h) + 'h ago', cls: 'posted-recent' };
  if (h < 48)  return { text: 'yesterday', cls: 'posted-recent' };
  const d = Math.round(h / 24);
  return { text: d + 'd ago', cls: d < 7 ? 'posted-recent' : 'posted-old' };
}

// ── NEW job tracking ───────────────────────────────────────────────────────────

function getSeenIds() {
  try { return new Set(JSON.parse(localStorage.getItem('myjobs_seen') || '[]')); }
  catch { return new Set(); }
}

function markSeen(ids) {
  const seen = getSeenIds();
  ids.forEach(id => seen.add(id));
  try { localStorage.setItem('myjobs_seen', JSON.stringify([...seen])); } catch {}
}

// ── Sorting ────────────────────────────────────────────────────────────────────

function setSort(key) {
  sortKey = key;
  const allSortBtns = Array.from(document.querySelectorAll('#sortGroup .sort-btn'));
  const keyBtns = allSortBtns.slice(0, 3); // Score, Newest, Company
  keyBtns.forEach(b => b.classList.remove('active'));
  const labelMap = { score: 'score', posted: 'newest', company: 'company' };
  keyBtns.forEach(b => {
    if (b.textContent.trim().toLowerCase() === labelMap[key]) b.classList.add('active');
  });
  renderJobs(allJobs);
}

function sortedJobs(jobs) {
  const copy = [...jobs];
  if (sortKey === 'posted') {
    copy.sort((a, b) => {
      const ta = a.posted_at || a.scraped_at || '';
      const tb = b.posted_at || b.scraped_at || '';
      return tb.localeCompare(ta);
    });
  } else if (sortKey === 'company') {
    copy.sort((a, b) => (a.company_name || '').localeCompare(b.company_name || ''));
  } else {
    copy.sort((a, b) => (b.total_score || 0) - (a.total_score || 0));
  }
  return copy;
}

// ── Filter toggles ─────────────────────────────────────────────────────────────

function toggleFilter(name) {
  if (name === 'usOnly') {
    usOnly = !usOnly;
    document.getElementById('usOnlyBtn').classList.toggle('active', usOnly);
  } else if (name === 'newGrad') {
    newGrad = !newGrad;
    document.getElementById('newGradBtn').classList.toggle('active', newGrad);
  }
  fetchJobs();
}

// ── Company sidebar ────────────────────────────────────────────────────────────

function selectCompany(companyId) {
  activeCompanyId = companyId;
  document.querySelectorAll('.sidebar-company').forEach(el => el.classList.remove('active'));
  document.getElementById('sidebarAll').classList.toggle('active', companyId === null);
  if (companyId !== null) {
    const el = document.getElementById('co-' + companyId);
    if (el) el.classList.add('active');
  }
  fetchJobs();
}

async function loadSidebar() {
  try {
    const resp = await fetch('/api/companies');
    if (!resp.ok) return;
    const companies = await resp.json();
    const byIndustry = {};
    companies.forEach(c => {
      const ind = c.industry || 'other';
      if (!byIndustry[ind]) byIndustry[ind] = [];
      byIndustry[ind].push(c);
    });
    const sidebar = document.getElementById('sidebar');
    let html = `<div class="sidebar-all${activeCompanyId === null ? ' active' : ''}" id="sidebarAll" onclick="selectCompany(null)">All Companies</div>`;
    const industryOrder = ['tech', 'fintech', 'enterprise', 'other'];
    const sorted = [...industryOrder.filter(i => byIndustry[i]), ...Object.keys(byIndustry).filter(i => !industryOrder.includes(i))];
    sorted.forEach(industry => {
      const cos = byIndustry[industry] || [];
      html += `<div class="sidebar-section">
        <div class="sidebar-header">${industry.toUpperCase()} <span style="font-size:10px;color:var(--muted)">${cos.length}</span></div>
        <div class="sidebar-body">`;
      cos.forEach(c => {
        const isActive = activeCompanyId === c.id;
        html += `<div class="sidebar-company${isActive ? ' active' : ''}" id="co-${c.id}" onclick="selectCompany(${c.id})" title="${esc(c.name)}">
          <span>${esc(c.name)}</span>
          <span class="job-count-badge">${c.job_count}</span>
        </div>`;
      });
      html += `</div></div>`;
    });
    sidebar.innerHTML = html;
  } catch(e) {}
}

// ── Visa / role helpers ────────────────────────────────────────────────────────

function visaLabel(s) { return s === 1 ? 'CONFIRMED' : s === -1 ? 'NO SPONSOR' : 'UNCONFIRMED'; }
function visaClass(s) { return s === 1 ? 'visa-yes' : s === -1 ? 'visa-no' : 'visa-unknown'; }
function roleClass(r) {
  const m = { backend:'role-backend',cloud:'role-cloud',fullstack:'role-fullstack',frontend:'role-frontend',
              mobile:'role-mobile',network:'role-network',ds:'role-ds',ml:'role-ml' };
  return m[r] || 'role-other';
}
function scoreClass(s) { return s >= 70 ? 'high' : s >= 45 ? 'mid' : 'low'; }

function esc(s) {
  const d = document.createElement('div');
  d.textContent = s || '';
  return d.innerHTML;
}

function fmtH1b(n) {
  if (!n || n < 100) return '';
  if (n >= 1000) return (n / 1000).toFixed(1) + 'K';
  return n.toString();
}

// ── Render ─────────────────────────────────────────────────────────────────────

function renderJobs(jobs) {
  const seenIds = getSeenIds();
  const sorted = sortedJobs(jobs);
  const newIds = jobs.filter(j => !seenIds.has(String(j.id))).map(j => j.id);

  document.getElementById('statTotal').textContent = jobs.length;
  document.getElementById('statNew').textContent = newIds.length;
  const fresh = jobs.filter(j => {
    const ts = j.posted_at || j.scraped_at;
    if (!ts) return false;
    return (Date.now() - new Date(ts)) < 86400000;
  }).length;
  document.getElementById('statFresh').textContent = fresh;

  if (!sorted.length) {
    document.getElementById('jobsContainer').innerHTML =
      '<div class="empty"><h2>No jobs match these filters</h2><p>Try removing a filter or clicking <strong>Refresh Now</strong>.</p></div>';
    return;
  }

  const html = sorted.map((job, idx) => {
    const isNew = !seenIds.has(String(job.id));
    const sc = job.score_pct || 0;
    const rt = relTime(job.posted_at || job.scraped_at);

    const skillChips = (job.matched_skills || []).slice(0, 8)
      .map(s => `<span class="skill-chip skill-yes">✓ ${esc(s)}</span>`).join('');
    const missingChips = (job.missing_skills || []).slice(0, 3)
      .map(s => `<span class="skill-chip skill-no">✗ ${esc(s)}</span>`).join('');

    const expBadge = job.exp_years_max != null
      ? (job.exp_years_max > 3
          ? `<span class="badge badge-exp-high">${job.exp_years_max}+ YRS EXP</span>`
          : `<span class="badge badge-exp-ok">≤${job.exp_years_max} YRS EXP</span>`)
      : '';

    const h1bStr = fmtH1b(job.h1b_petitions_recent);

    return `
    <div class="job-card${isNew ? ' is-new' : ''}" data-id="${job.id}">
      ${isNew ? '<span class="new-badge">NEW</span>' : ''}
      <div class="card-top">
        <span class="card-rank">#${idx + 1}</span>
        <div class="card-title-group">
          <div class="card-title">${esc(job.title)}</div>
          <div class="card-company">${esc(job.company_name || '')}${job.domain ? ' · ' + esc(job.domain) : ''}</div>
        </div>
        <div class="score-circle ${scoreClass(sc)}">${sc}</div>
      </div>

      <div class="badges">
        <span class="badge ${visaClass(job.visa_signal)}">${visaLabel(job.visa_signal)}</span>
        ${job.role_category ? `<span class="badge ${roleClass(job.role_category)}">${job.role_category.toUpperCase()}</span>` : ''}
        ${job.remote ? '<span class="badge badge-remote">REMOTE</span>' : ''}
        ${job.tier === 1 ? '<span class="badge badge-tier1">TIER 1</span>' : ''}
        ${expBadge}
        <span class="badge badge-src">${(job.ats_type || '').toUpperCase()}</span>
      </div>

      <div class="meta">
        ${job.location ? `<span>📍 ${esc(job.location)}</span>` : ''}
        ${rt ? `<span class="posted-time ${rt.cls}">🕐 ${rt.text}</span>` : job.posted_date ? `<span>📅 ${job.posted_date}</span>` : ''}
        ${job.industry ? `<span>🏢 ${esc(job.industry)}</span>` : ''}
        ${h1bStr ? `<span title="USCIS H-1B petitions (2022-2024)" style="color:#a78bfa">🛂 ${h1bStr} H-1B</span>` : ''}
      </div>

      ${skillChips || missingChips ? `<div class="skills-row">${skillChips}${missingChips}</div>` : ''}

      <div class="score-breakdown">
        <div class="score-item"><span class="pts">${job.skill_pts ?? 0}</span><span class="max">/${WEIGHTS.skill}</span><span class="lbl">Skill</span></div>
        <div class="score-item"><span class="pts">${job.role_pts ?? 0}</span><span class="max">/${WEIGHTS.role}</span><span class="lbl">Role</span></div>
        <div class="score-item"><span class="pts">${job.visa_pts ?? 0}</span><span class="max">/${WEIGHTS.visa}</span><span class="lbl">Visa</span></div>
        <div class="score-item"><span class="pts">${job.recency_pts ?? 0}</span><span class="max">/${WEIGHTS.recency}</span><span class="lbl">Recency</span></div>
        <div class="score-item"><span class="pts">${job.company_pts ?? 0}</span><span class="max">/${WEIGHTS.company}</span><span class="lbl">Company</span></div>
      </div>

      <div class="card-footer">
        <a class="apply-btn" href="${esc(job.url)}" target="_blank" rel="noopener">Apply ↗</a>
      </div>
    </div>`;
  }).join('');

  document.getElementById('jobsContainer').innerHTML = html;

  if (newIds.length) {
    setTimeout(() => {
      markSeen(newIds);
      document.querySelectorAll('.job-card.is-new').forEach(c => c.classList.remove('is-new'));
      document.querySelectorAll('.new-badge').forEach(b => b.remove());
    }, 8000);
  }
}

// ── Fetch jobs from API ────────────────────────────────────────────────────────

async function fetchJobs() {
  try {
    const params = new URLSearchParams();
    if (usOnly) params.set('us_only', 'true');
    if (newGrad) params.set('new_grad_only', 'true');
    if (activeCompanyId !== null) params.set('company_id', activeCompanyId);
    const url = '/api/jobs' + (params.toString() ? '?' + params.toString() : '');
    const resp = await fetch(url);
    if (!resp.ok) throw new Error('HTTP ' + resp.status);
    allJobs = await resp.json();
    renderJobs(allJobs);
    document.getElementById('lastRefreshed').textContent = 'Updated ' + new Date().toLocaleTimeString();
  } catch (e) {
    document.getElementById('lastRefreshed').textContent = 'Fetch error — ' + e.message;
  }
}

// ── Trigger pipeline refresh ───────────────────────────────────────────────────

let pollingStatus = false;

async function triggerRefresh() {
  const btn = document.getElementById('refreshBtn');
  btn.disabled = true;
  btn.innerHTML = '<div class="spinner"></div> Scraping…';

  try {
    const r = await fetch('/api/refresh', { method: 'POST' });
    const d = await r.json();
    if (d.status === 'already_running') {
      showToast('Scrape already in progress…');
    }
    pollStatus();
  } catch (e) {
    btn.disabled = false;
    btn.innerHTML = 'Refresh Now';
    showToast('Error: ' + e.message);
  }
}

async function pollStatus() {
  if (pollingStatus) return;
  pollingStatus = true;
  const btn = document.getElementById('refreshBtn');

  while (true) {
    await sleep(3000);
    try {
      const r = await fetch('/api/status');
      const d = await r.json();
      if (d.status === 'idle') {
        btn.disabled = false;
        btn.innerHTML = 'Refresh Now';
        pollingStatus = false;
        nextRefreshAt = Date.now() + AUTO_REFRESH_MS;
        await fetchJobs();
        await loadSidebar();
        const newCount = document.getElementById('statNew').textContent;
        showToast(newCount + ' new job' + (newCount === '1' ? '' : 's') + ' found');
        return;
      }
      if (d.task_error) {
        btn.disabled = false;
        btn.innerHTML = 'Refresh Now';
        pollingStatus = false;
        showToast('Scrape error: ' + d.task_error);
        return;
      }
    } catch {}
  }
}

// ── Countdown & auto-poll ──────────────────────────────────────────────────────

function updateCountdown() {
  const remaining = Math.max(0, nextRefreshAt - Date.now());
  const m = Math.floor(remaining / 60000);
  const s = Math.floor((remaining % 60000) / 1000);
  document.getElementById('countdown').textContent =
    remaining > 0
      ? `Auto-refresh in ${m}:${String(s).padStart(2, '0')}`
      : 'Refreshing…';
}

function startAutoRefresh() {
  clearInterval(countdownTimer);
  countdownTimer = setInterval(updateCountdown, 1000);
  clearTimeout(pollTimer);
  function scheduleNext() {
    const delay = nextRefreshAt - Date.now();
    pollTimer = setTimeout(async () => {
      nextRefreshAt = Date.now() + AUTO_REFRESH_MS;
      await fetchJobs();
      scheduleNext();
    }, Math.max(delay, 1000));
  }
  scheduleNext();
}

// ── Toast ──────────────────────────────────────────────────────────────────────

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.remove('hidden');
  setTimeout(() => t.classList.add('hidden'), 4000);
}

function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

// ── Init ───────────────────────────────────────────────────────────────────────

(async () => {
  await Promise.all([fetchJobs(), loadSidebar()]);
  startAutoRefresh();
})();
</script>

