# --- Database & Queue (required) ---
LOCAL_DATABASE_URL=postgresql://crawler:crawler@localhost:5432/crawler
REDIS_URL=redis://localhost:6379/0
# Host ports used by docker-compose (change if something else already uses them)
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# --- Public API ---
# API_RATE_LIMIT_PER_MINUTE=120
# API_CORS_ORIGINS=https://your-frontend.example   # comma-separated; empty = same-origin only

# --- Admin (/admin page and /api/admin/*, D31) ---
# Login is user "admin" with this password; leave empty to turn the admin side off. e.g. `openssl rand -hex 24`
ADMIN_TOKEN=

# --- Public URL (D32) ---
# Token of the tunnel created in Cloudflare's dashboard (Networks → Tunnels); its public hostname → http://localhost:3000
TUNNEL_TOKEN=

# --- Proxy (optional, off by default) ---
# Boards with "proxy": true in monitor_config use this when set. Without it they
# attempt a direct connection and may fail on hosts that block datacenter IPs.
# PROXY_PROVIDER=webshare
# WEBSHARE_PROXY_URL=http://user:pass@host:port
