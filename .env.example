# --- Database & Queue (required) ---
LOCAL_DATABASE_URL=postgresql://crawler:crawler@localhost:5432/crawler
REDIS_URL=redis://localhost:6379/0

# --- Required for Phase 2 (resume/cover letter generation) ---
ANTHROPIC_API_KEY=

# Personal files live in private/ (gitignored). Filenames are relative to RESUME_DIR.
# RESUME_DIR=private/resumes
# PROFILE_PATH=private/profile.txt
RESUME_SWE=resume_swe.pdf
RESUME_CLOUD=resume_cloud.pdf
RESUME_NETWORK=resume_network.pdf
RESUME_DS=resume_ds.pdf
RESUME_ML=resume_ml.pdf

# Proxy (opt-in for Phase 3+ jobseek integration).
# Boards with "proxy":true in scraper_config use this when set.
# Leave unset to run without a proxy — those boards will attempt direct
# connection and fail loudly on hosts that block datacenter IPs
# (Cisco, Mastercard, NVIDIA, Qualcomm, Uber in your overlap set).
# PROXY_PROVIDER=webshare
# WEBSHARE_PROXY_URL=http://user:pass@host:port
